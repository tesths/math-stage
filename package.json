{
  "name": "math-platform",
  "private": true,
  "type": "module",
  "description": "小学数学互动学习平台：门户 + 一至六年级单 Pages 聚合构建",
  "packageManager": "npm@12.0.1",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "workspaces": [
    "g1/game",
    "g2/game",
    "g3/game",
    "g4/game",
    "g5/game",
    "g6/game",
    "portal",
    "shared"
  ],
  "scripts": {
    "install:all": "npm ci --ignore-scripts --no-audit --no-fund",
    "build:site": "node scripts/site-build.mjs",
    "build:site:local": "node scripts/site-build.mjs --skip-install",
    "generate:g1": "node scripts/run-app-script.mjs g1 generate:site",
    "generate:g2": "node scripts/run-app-script.mjs g2 generate:site",
    "generate:g3": "node scripts/run-app-script.mjs g3 generate:site",
    "generate:g4": "node scripts/run-app-script.mjs g4 generate:site",
    "generate:g5": "node scripts/run-app-script.mjs g5 generate:site",
    "generate:g6": "node scripts/run-app-script.mjs g6 generate:site",
    "generate:portal": "node scripts/run-app-script.mjs portal generate:site",
    "prepare:nuxt": "node scripts/prepare-nuxt.mjs",
    "preview": "npx serve deploy",
    "test": "npm run test:unit",
    "test:unit": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "typecheck": "npm run prepare:nuxt && npm run typecheck:apps",
    "typecheck:apps": "npm run typecheck --workspaces --if-present",
    "test:shared": "node scripts/test-shared.mjs",
    "test:shared:coverage": "node scripts/test-shared.mjs --coverage",
    "test:click": "node scripts/real-click-test.mjs"
  },
  "dependencies": {
    "@iconify-json/heroicons": "1.2.3",
    "@iconify-json/lucide": "1.2.121",
    "@nuxt/ui": "4.10.0",
    "animejs": "4.5.0",
    "chart.js": "4.5.1",
    "jsxgraph": "1.13.1",
    "nuxt": "4.5.1",
    "three": "0.180.0",
    "vue": "3.5.40",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@nuxt/test-utils": "3.23.0",
    "@playwright/test": "1.62.1",
    "@types/animejs": "3.1.13",
    "@types/three": "0.180.0",
    "@typescript-eslint/eslint-plugin": "8.66.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "3.2.7",
    "@vue/test-utils": "2.4.11",
    "happy-dom": "16.8.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "vue-tsc": "2.2.12"
  }
}
